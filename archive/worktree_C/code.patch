+def pick_parent(genomes, sel_fitness, args, rng, order=None):
+    """One parent index.  rank: rank-weighted among the top --survivors;
+    tournament: best (random tie-break) of --tournament-size random members."""
+    if args.selection == "tournament":
+        idx = rng.choice(len(genomes), size=min(args.tournament_size, len(genomes)),
+                         replace=False)
+        f = sel_fitness[idx] + 1e-9 * rng.random(len(idx))
+        return int(idx[np.argmax(f)])
+    if order is None:
+        order = np.lexsort((rng.random(len(genomes)), -sel_fitness))
+    k = min(args.survivors, len(genomes))
+    w = np.arange(k, 0, -1, dtype=float)
+    return int(order[rng.choice(k, p=w / w.sum())])
+
