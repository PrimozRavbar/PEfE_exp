+def run_steady(args, rng, bcfg, ecfg, log_path):
+    """Steady-state scheme.  Each step: B children + R re-evaluated members are
+    evaluated together (mixed arenas or clone teams); every member keeps a
+    running-mean fitness estimate; the population is then the best N of
+    (members + children) by estimate.  The initial population is evaluated
+    before the first step."""
+    N, B, R = args.population, args.ss_children, min(args.ss_reeval, args.population)
+    if args.eval_mode == "mixed" and (B + R) % args.arena_size:
+        raise SystemExit("--ss-children + --ss-reeval must be a multiple of --arena-size")
+    if args.eval_mode == "mixed" and N % args.arena_size:
+        raise SystemExit("--population must be a multiple of --arena-size")
+    pop = [init_genome(args, rng) for _ in range(N)]
+    est, cnt = evaluate_population(pop, args, rng, bcfg, ecfg)[0], np.ones(N)
+    evals = N * args.episodes * (args.arena_size if args.eval_mode == "clone" else 1)
+    best_valid, t_start = -1.0, time.perf_counter()
+    for step in range(args.generations):
+        t0 = time.perf_counter()
+        conns = np.array([g.n_connections() for g in pop])
+        sel = est - args.connection_cost * conns
+        order = np.lexsort((rng.random(N), -sel))
+        children = [make_child(pop[pick_parent(pop, sel, args, rng, order)], args, rng)
+                    for _ in range(B)]
+        re_idx = order[:R]
+        batch = children + [pop[i] for i in re_idx]
+        f, used = evaluate_population(batch, args, rng, bcfg, ecfg)
+        evals += used
+        # update estimates of re-evaluated members (EMA with growing window)
+        for j, i in enumerate(re_idx):
+            cnt[i] += 1
+            a = max(1.0 / cnt[i], 1.0 / args.ss_max_count)
+            est[i] += a * (f[B + j] - est[i])
+        allg = pop + children
+        alle = np.concatenate([est, f[:B]])
+        allc = np.concatenate([cnt, np.ones(B)])
+        allconn = np.array([g.n_connections() for g in allg])
+        allsel = alle - args.connection_cost * allconn
+        keep = np.lexsort((rng.random(len(allg)), -allsel))[:N]
+        pop = [allg[i] for i in keep]
+        est, cnt, conns = alle[keep], allc[keep], allconn[keep]
+        sel = allsel[keep]
+        # "best" = best estimate among members evaluated at least twice
+        trusted = cnt >= 2
+        cand = np.where(trusted, sel, -np.inf) if trusted.any() else sel
+        b = int(np.argmax(cand))
+
+        valid = ""
+        last = step == args.generations - 1 or (args.max_evals and evals >= args.max_evals)
+        if (step + 1) % args.check_every == 0 or last:
+            v = validate(pop[b], args, bcfg, ecfg, step)
+            valid = f"{v:.3f}"
+            if v > best_valid:
+                best_valid = v
+                P.save_genome(os.path.join(args.out, "best.npz"), pop[b], bcfg,
+                              {"generation": step, "valid": v, "evals": int(evals),
+                               "run": args.out, "estimate": float(est[b]),
+                               "count": int(cnt[b])})
+        dt = time.perf_counter() - t0
+        with open(log_path, "a", newline="") as fh:
+            csv.writer(fh).writerow([step, int(evals), f"{est[b]:.3f}", f"{est.mean():.3f}",
+                                     f"{np.median(est):.3f}", int(conns[b]),
+                                     f"{conns.mean():.1f}", valid, f"{best_valid:.3f}",
+                                     f"{dt:.2f}", f"{f[:B].mean():.3f}", int(cnt[b])])
+        print(f"step {step:4d} evals {evals:7d} best-est {est[b]:6.2f} (n={int(cnt[b])}) "
+              f"mean {est.mean():6.2f} children {f[:B].mean():6.2f} "
+              f"conns {conns[b]:5d}/{conns.mean():7.1f}" + (f" valid {valid}" if valid else "")
+              + f" ({dt:.1f}s)", flush=True)
+        if last:
+            break
+    _save_pop(os.path.join(args.out, "final_pop.npz"), pop, est)
+    print(f"done in {time.perf_counter() - t_start:.0f}s; best validation {best_valid:.2f}")
+
