diff --git a/src/pefe_np.py b/src/pefe_np.py
index b538080..5f981f1 100644
--- a/src/pefe_np.py
+++ b/src/pefe_np.py
@@ -117,12 +117,20 @@ class Genome:
 
     # -- mutation (faithful to genome_pe3; extra knobs default to old behavior)
     def mutate(self, rng, mutation_rate=0.1, mutation_scale=0.05,
-               mutate_hyper=True):
-        """Perturb existing (nonzero) weights; perturb hyperparameters."""
+               mutate_hyper=True, relative_scale=0.0):
+        """Perturb existing (nonzero) weights; perturb hyperparameters.
+
+        relative_scale > 0 adds a multiplicative term: w += N(0,1)*rel*|w|,
+        so big weights move proportionally (default 0 = genome_pe3 behaviour).
+        """
         for _, W, _ in self.matrices():
             mask = (W != 0) & (rng.random(W.shape) < mutation_rate)
             if mask.any():
-                W[mask] += (rng.standard_normal(int(mask.sum())) * mutation_scale).astype(np.float32)
+                k = int(mask.sum())
+                W[mask] += (rng.standard_normal(k) * mutation_scale).astype(np.float32)
+                if relative_scale > 0:
+                    W[mask] += (rng.standard_normal(k) * relative_scale
+                                * np.abs(W[mask])).astype(np.float32)
         if mutate_hyper:
             hm = rng.random(NUM_HYPERPARAMETERS) < mutation_rate
             self.hyper[hm] += (rng.standard_normal(int(hm.sum())) * mutation_scale).astype(np.float32)
